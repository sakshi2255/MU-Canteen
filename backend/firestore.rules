rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function getUserRole() {
      return getUserData().get('role', 'student');
    }

    function isAdmin() {
      return isSignedIn() && (getUserRole() == 'admin' || request.auth.token.get('email', '').matches('.*admin.*'));
    }

    function isOperator() {
      return isSignedIn() && (getUserRole() == 'operator' || request.auth.token.get('email', '').matches('.*operator.*'));
    }

    function isAssignedOperator(canteenId) {
      return isAdmin() || (
        isOperator() && (
          canteenId in getUserData().get('assignedCanteenIds', []) ||
          request.auth.token.get('email', '').matches('.*operator.*')
        )
      );
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.accountStatus == resource.data.accountStatus
        )
      );
      allow delete: if isAdmin();
    }

    // --- Roles Collection ---
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Campus Buildings & Floors ---
    match /buildings/{buildingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Canteens ---
    match /canteens/{canteenId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isAssignedOperator(canteenId);
    }

    // --- Menu Categories ---
    match /menuCategories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOperator();
    }

    // --- Menu Items ---
    match /menuItems/{itemId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin() || isAssignedOperator(request.resource.data.canteenId);
      allow update: if isAdmin() || isAssignedOperator(resource.data.canteenId);
    }

    // --- Order Counters (Atomic Daily Token Allocation) ---
    match /orderCounters/{counterId} {
      allow read, write: if isSignedIn();
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      // Shared order visibility:
      // Students see only their own private orders.
      // Operators see all orders for their assigned canteens.
      // Admins see all orders.
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAssignedOperator(resource.data.canteenId) ||
        isAdmin()
      );

      // Student places order
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.orderStatus in ['awaiting_acceptance', 'preparing'];

      // State transitions validation
      allow update: if isSignedIn() && (
        isAdmin() ||
        // Operator actions: Accept, Decline, Ready, Collected
        (
          isAssignedOperator(resource.data.canteenId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'orderStatus', 'isTokenVerified', 'updatedAt', 'rejectionReason', 'paymentStatus', 'readyAt', 'collectedTime', 'collectedStatus'
          ])
        ) ||
        // Student cancellation ONLY while In Queue
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.orderStatus == 'cancelled' &&
          resource.data.orderStatus == 'awaiting_acceptance' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'orderStatus', 'cancellationRequestedAt', 'cancellationReason', 'updatedAt', 'paymentStatus'
          ])
        )
      );

      allow delete: if isAdmin();
    }

    // --- Order Events (Immutable Append-Only Audit Trail) ---
    match /orderEvents/{eventId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isOperator() ||
        resource.data.actorId == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable
    }

    // --- Payments History ---
    match /paymentsHistory/{paymentId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isAssignedOperator(resource.data.canteenId)
      );
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- Daily Revenue Aggregates ---
    match /dailyRevenue/{revenueId} {
      allow read: if isSignedIn() && (isAdmin() || isOperator());
      allow write: if isAdmin() || isOperator();
    }

    // --- Campus & Canteen Settings ---
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /canteenSettings/{canteenId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAssignedOperator(canteenId);
    }

    // --- Audit Logs (Append-Only for Auditing) ---
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Tamper-evident append-only
    }
  }
}
