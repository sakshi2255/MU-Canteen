{
  "name": "mu-canteen-functions",
  "scripts": {
    "build": "tsc",
    "test": "node --test ../tests/securityAndFunctions.test.mjs",
    "seed": "cross-env NODE_PATH=./node_modules ts-node --project ../scripts/tsconfig.json ../scripts/seedData.ts",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "private": true
}
